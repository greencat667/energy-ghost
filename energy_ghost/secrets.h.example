// Copy this file to secrets.h and fill in your own values.
#ifndef SECRETS_H
#define SECRETS_H

#define WIFI_SSID     "your-wifi-name"
#define WIFI_PASSWORD "your-wifi-password"

// Standalone device - no relay to configure. It calls the Carbon Intensity
// API and ip-api.com directly. Leave this empty to auto-detect location via
// IP geolocation (see carbon_api.cpp's detect_postcode()); IP geolocation
// reflects the ISP's routing, not the building, and can be off by a real
// distance - set a UK outward postcode code here (e.g. "SW1A") to pin it.
#define MANUAL_POSTCODE ""

#endif
